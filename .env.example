# ============================================================
# LOVEBOX ANALYTICS — credentials
# Copie ce fichier en `.env` et remplis les valeurs.
# Rien ne tourne tant que `npm run doctor` n'est pas vert.
# ============================================================

# ---------- Anthropic (agents d'analyse Claude — étape 2) ----------
ANTHROPIC_API_KEY=sk-ant-...
# Modèle par défaut des agents. Surchargeable si besoin (ex. tests, fallback).
ANALYTICS_MODEL=claude-opus-5

# ---------- Google OAuth2 (GA4 + Search Console) ----------
# On NE régénère PAS de token : on réutilise tel quel celui déjà généré par le
# module `Suppression BLOG Useless` (scopes analytics.readonly + webmasters.readonly).
# Ce chemin pointe donc par défaut sur son token existant.
# Si besoin de le régénérer (token révoqué, machine différente) : npm run auth-google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_TOKEN_PATH=../Suppression BLOG Useless/data/google-token.json

# Property ID GA4 (le numéro, ex: 123456789)
GA4_PROPERTY_ID=

# ---------- Shopify Admin API (lecture des commandes) ----------
# Les apps custom actuelles n'ont que read_content/write_content : le scope
# read_orders manque. Tant qu'il n'est pas ajouté, `shopify.js` renvoie
# { ok:false, reason:"scope read_orders manquant" } — c'est le cas nominal
# aujourd'hui, pas un bug. `npm run doctor` explique quoi faire.
SHOPIFY_STORE_EN_DOMAIN=xxx.myshopify.com
SHOPIFY_STORE_EN_TOKEN=shpat_...

SHOPIFY_STORE_FR_DOMAIN=xxx.myshopify.com
SHOPIFY_STORE_FR_TOKEN=shpat_...

SHOPIFY_STORE_EU_DOMAIN=xxx.myshopify.com
SHOPIFY_STORE_EU_TOKEN=shpat_...

# ---------- Slack (étape 2 — envoi du rapport) ----------
# Bot token (xoxb-...) avec scopes: chat:write, chat:write.public
SLACK_BOT_TOKEN=xoxb-...
# Channel ID (ex: C0123456789) — clic droit sur le channel > copier l'ID
SLACK_CHANNEL_ID=

# ---------- Garde-fous de significativité (config/thresholds.json reprend
# ces valeurs par défaut ; ces variables permettent de les surcharger sans
# toucher au fichier de config) ----------
# Base minimale de sessions avant d'afficher une variation en %.
SIGNIFICANCE_MIN_SESSIONS=100
# Base minimale de transactions avant d'afficher une variation en %.
SIGNIFICANCE_MIN_TRANSACTIONS=5
