{
  "_note": "Seuils utilisés par metrics.js (significativité), insights.js (SEO) et quality.js (contrôles). Les seuils de significativité peuvent être surchargés par les variables d'environnement SIGNIFICANCE_MIN_SESSIONS / SIGNIFICANCE_MIN_TRANSACTIONS sans toucher ce fichier.",

  "dataReadiness": {
    "minDaysAfterMonthEnd": 3
  },

  "significance": {
    "minSessions": 100,
    "minTransactions": 5
  },

  "seo": {
    "strikingDistance": {
      "minPosition": 4,
      "maxPosition": 15,
      "minImpressions": 100,
      "topN": 20
    },
    "ctrUnderperforming": {
      "ratioOfMedian": 0.5
    },
    "winnersLosers": {
      "minClickDelta": 3,
      "topN": 20
    },
    "cannibalization": {
      "minPagesPerQuery": 2,
      "minImpressionsPerPage": 50
    },
    "positionBuckets": [
      { "key": "1-3", "min": 1, "max": 3 },
      { "key": "4-10", "min": 4, "max": 10 },
      { "key": "11-20", "min": 11, "max": 20 },
      { "key": "21+", "min": 21, "max": null }
    ]
  },

  "quality": {
    "unknownHostsCriticalPct": 5,
    "noiseShareWarnPct": 5,
    "noiseShareCriticalPct": 15,
    "revenueMissingMinSessions": 50,
    "ga4ShopifyDiscrepancyWarnPct": 10,
    "cardinalityWarnPct": 5,
    "unassignedWarnPct": 10,
    "unassignedCriticalPct": 25,
    "dataGapsCriticalDays": 3,
    "minGscRowsHealthy": 10
  },

  "shopify": {
    "maxCustomersPerStore": 500,
    "customerCacheTtlHours": 24
  }
}
